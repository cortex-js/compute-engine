// Run with the opt-in installer in group-probe.ts.
function smallGroupElements(g: PermutationGroup) -> list<Permutation> {
  PermutationGroupElements(g, 6, 12)
}

let p = Permutation([2, 1])
let q = Permutation([1, 3, 2])
let S3 = PermutationGroup([p, q], PermutationAction(3))
let complete = smallGroupElements(S3)
let trivial = PermutationGroup([], PermutationAction(5))

(count(complete), complete, PermutationGroupElements(trivial, 1, 0))