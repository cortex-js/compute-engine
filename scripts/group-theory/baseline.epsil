// Run with the opt-in installer in baseline-probe.ts.
function groupSize(g: PermutationGroup) -> integer {
  PermutationGroupOrder(g, 5000000)
}
let G = PermutationGroup([Permutation([2, 1]), Permutation([1, 3, 2])], PermutationAction(3))
let H = PermutationGroup([Permutation([2, 3, 1])], PermutationAction(3))
let stabilizer = PermutationPointStabilizer(G, 1, 5000000)
(groupSize(G), groupSize(stabilizer), PermutationSubgroupIndex(G, H, 5000000),
 PermutationIsNormal(G, H, 5000000),
 PermutationGroupContains(H, Permutation([2, 1]), 5000000),
 PermutationOrder(Permutation([2, 3, 1])), PermutationPower(Permutation([2, 3, 1]), -1))
