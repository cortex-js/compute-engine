// Research-only algebra model. Nominal payloads do not prove bijectivity.
protocol PhaseGroupElement {
  function phase_compose(self: Self, other: Self) -> Self
  function phase_identity(self: Self) -> Self
}

type PhasePermutation = tuple<images: list<integer>> is PhaseGroupElement {
  function phase_compose(self: Self, other: Self) -> Self {
    PhasePermutation(listFrom(map((i: integer) => other.images[i], self.images)))
  }
  function phase_identity(self: Self) -> Self {
    PhasePermutation(listFrom([i for i in 1..count(self.images)]))
  }
}

type PhaseResidue = tuple<modulus: integer, residue: integer> is PhaseGroupElement {
  function phase_compose(self: Self, other: Self) -> Self {
    if self.modulus != other.modulus {
      RuntimeError("phase-domain-mismatch")
    } else {
      PhaseResidue(self.modulus, (self.residue + other.residue) % self.modulus)
    }
  }
  function phase_identity(self: Self) -> Self { PhaseResidue(self.modulus, 0) }
}

function phase_square(x: T) -> T where T is PhaseGroupElement {
  PhaseGroupElement.phase_compose(x, x)
}

type PhasePermutationGroup = tuple<generators: list<PhasePermutation>>

// A bounded closure experiment for validated, equal-degree fixture generators.
// This deliberately exercises Epsil control flow; it is not an order algorithm.
function phase_elements(g: PhasePermutationGroup, maxElements: integer) -> list<PhasePermutation> {
  if count(g.generators) == 0 { Return(RuntimeError("phase-empty-generators")) }
  if maxElements < 1 { Return(RuntimeError("phase-element-limit")) }
  let elements: list<PhasePermutation> = [PhaseGroupElement.phase_identity(g.generators[1])]
  let cursor = 1
  while cursor <= count(elements) {
    for generator in g.generators {
      let candidate: PhasePermutation = PhaseGroupElement.phase_compose(elements[cursor], generator)
      if contains(elements, candidate) == false {
        if count(elements) >= maxElements { Return(RuntimeError("phase-element-limit")) }
        elements = listFrom(join(elements, [candidate]))
      }
    }
    cursor = cursor + 1
  }
  elements
}
