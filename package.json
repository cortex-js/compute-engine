{
  "version": "0.169.2",
  "scripts": {
    "doc": "bash ./scripts/doc.sh",
    "build": "bash ./scripts/build.sh",
    "clean": "bash ./scripts/clean.sh",
    "coverage": "bash ./scripts/test.sh coverage",
    "dist": "bash ./scripts/build.sh production; bash ./scripts/test.sh",
    "prepare": "bash ./scripts/build.sh production",
    "start": "bash ./scripts/start.sh",
    "snapshot": "bash ./scripts/test.sh snapshot",
    "version": "bash ./scripts/version.sh",
    "prepublishOnly": "bash ./scripts/prepublish-check.sh",
    "postpublish": "bash ./scripts/package-vsix.sh",
    "test": "bash ./scripts/test.sh",
    "test:nodenext": "node ./test/consumer/nodenext-smoke.mjs",
    "test:js-runtime": "node ./test/consumer/js-runtime-smoke.mjs",
    "test:epsil-runtime": "node ./test/consumer/epsil-runtime-smoke.mjs",
    "test:epsil-cli": "node ./test/consumer/epsil-cli-smoke.mjs",
    "epsil:corpus-report": "npx --yes tsx scripts/epsil-corpus-report.ts",
    "test:nightly": "CE_NIGHTLY=1 jest --config ./config/jest.config.cjs --reporters default -- test/compute-engine/nightly/",
    "test:perf": "CE_PERF=1 jest --config ./config/jest.config.cjs --runInBand --reporters default -- $(grep -rl CE_PERF test --include=*.test.ts)",
    "check:deps": "madge --circular --extensions ts src/compute-engine && echo 'No circular dependencies found'",
    "check:corpus": "npx --yes tsx docs/mathnet/scripts/check-corpus.ts",
    "check:roundtrip": "npx --yes tsx docs/mathnet/scripts/check-roundtrip.ts",
    "lint": "npm run lint:code && npm run typecheck && npm run ci:corpus-pipeline",
    "lint:code": "oxlint src && prettier --write 'src/**/*.{ts,js,css,md}'",
    "ci:corpus-pipeline": "npx --yes tsx scripts/fungrim/validate.ts --corpus data/fungrim --check && npx --yes tsx scripts/fungrim/artifact-freshness.ts && npx --yes tsx scripts/fungrim/apply-solve-templates.ts --check && npx --yes tsx scripts/fungrim/recompile-drift.ts && npx --yes tsx scripts/fungrim/compile-properties.ts --check && npx --yes tsx scripts/rubi/bundle-corpus.ts && git diff --exit-code -- src/compute-engine/rubi/rubi-rules-data.json && npm run check:corpus && npm run check:roundtrip",
    "ci": "npm run lint && npm test",
    "typecheck": "bash ./scripts/typecheck.sh"
  },
  "name": "@cortex-js/compute-engine",
  "description": "Symbolic computing and numeric evaluations for JavaScript and Node.js",
  "homepage": "https://cortexjs.io/compute-engine/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cortex-js/compute-engine.git"
  },
  "bugs": "https://github.com/cortex-js/compute-engine/issues/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "math",
    "JSON",
    "mathjs",
    "mathematica",
    "maple",
    "algebra",
    "symbolic computing",
    "scientific computing",
    "sympy"
  ],
  "license": "MIT",
  "bin": {
    "epsil": "./dist/esm-min/cli/epsil.js"
  },
  "files": [
    "/CHANGELOG.md",
    "/dist/esm-min",
    "/dist/umd-min",
    "/dist/types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/compute-engine.d.ts",
      "import": "./dist/esm-min/compute-engine.js",
      "require": "./dist/umd-min/compute-engine.cjs",
      "default": "./dist/esm-min/compute-engine.js"
    },
    "./math-json": {
      "types": "./dist/types/math-json.d.ts",
      "import": "./dist/esm-min/math-json.js",
      "require": "./dist/umd-min/math-json.cjs",
      "default": "./dist/esm-min/math-json.js"
    },
    "./latex-syntax": {
      "types": "./dist/types/latex-syntax.d.ts",
      "import": "./dist/esm-min/latex-syntax.js",
      "require": "./dist/umd-min/latex-syntax.cjs",
      "default": "./dist/esm-min/latex-syntax.js"
    },
    "./interval": {
      "types": "./dist/types/interval.d.ts",
      "import": "./dist/esm-min/interval.js",
      "require": "./dist/umd-min/interval.cjs",
      "default": "./dist/esm-min/interval.js"
    },
    "./numerics": {
      "types": "./dist/types/numerics.d.ts",
      "import": "./dist/esm-min/numerics.js",
      "require": "./dist/umd-min/numerics.cjs",
      "default": "./dist/esm-min/numerics.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/esm-min/core.js",
      "require": "./dist/umd-min/core.cjs",
      "default": "./dist/esm-min/core.js"
    },
    "./compile": {
      "types": "./dist/types/compile.d.ts",
      "import": "./dist/esm-min/compile.js",
      "require": "./dist/umd-min/compile.cjs",
      "default": "./dist/esm-min/compile.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/esm-min/runtime.js",
      "require": "./dist/umd-min/runtime.cjs",
      "default": "./dist/esm-min/runtime.js"
    },
    "./kernel-worker": {
      "types": "./dist/types/kernel-worker.d.ts",
      "import": "./dist/esm-min/kernel-worker.js",
      "default": "./dist/esm-min/kernel-worker.js"
    },
    "./identities": {
      "types": "./dist/types/identities.d.ts",
      "import": "./dist/esm-min/identities.js",
      "require": "./dist/umd-min/identities.cjs",
      "default": "./dist/esm-min/identities.js"
    },
    "./integration-rules": {
      "types": "./dist/types/integration-rules.d.ts",
      "import": "./dist/esm-min/integration-rules.js",
      "require": "./dist/umd-min/integration-rules.cjs",
      "default": "./dist/esm-min/integration-rules.js"
    },
    "./epsil": {
      "types": "./dist/types/epsil.d.ts",
      "import": "./dist/esm-min/epsil.js",
      "require": "./dist/umd-min/epsil.cjs",
      "default": "./dist/esm-min/epsil.js"
    },
    "./cli": {
      "import": "./dist/esm-min/cli/epsil.js",
      "default": "./dist/esm-min/cli/epsil.js"
    }
  },
  "main": "./dist/esm-min/compute-engine.js",
  "module": "./dist/esm-min/compute-engine.js",
  "browser": "./dist/umd-min/compute-engine.cjs",
  "unpkg": "./dist/umd-min/compute-engine.cjs",
  "types": "./dist/types/compute-engine.d.ts",
  "engines": {
    "npm": ">=10.5.0",
    "node": ">=22.3.0"
  },
  "devDependencies": {
    "@cortex-js/prettier-config": "^1.2.0",
    "@jest/console": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chalk": "^6.0.1",
    "check-node-version": "^4.2.1",
    "concat-md": "^0.5.1",
    "decimal.js": "^10.6.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-silent-reporter": "^0.6.0",
    "madge": "^8.0.0",
    "open": "^11.0.4",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-2": "npm:prettier@^3.9.10",
    "serve-http": "^1.0.7",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "update-notifier": "^7.3.1"
  },
  "prettier": "@cortex-js/prettier-config",
  "dependencies": {
    "@arnog/colors": "^0.7.3",
    "complex.js": "^2.4.3"
  }
}
