{
  // `Epsil: Run File` runs the CLI bundled with the extension by default —
  // in the dev host that is the repo source as of the last `npm run build`
  // in vscode-epsil/ (or live, under `npm run watch`). No `epsil.cliCommand`
  // override is needed; setting one here would pin Run File to a different
  // (possibly stale) engine build.
}
