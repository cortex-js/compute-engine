{
  "name": "epsil",
  "displayName": "Epsil",
  "description": "Language support for Epsil — syntax highlighting, diagnostics, and run commands for .epsil files",
  "version": "0.123.1",
  "publisher": "FarfieldStudio",
  "license": "MIT",
  "icon": "icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cortex-js/compute-engine.git",
    "directory": "vscode-epsil"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "epsil",
    "mathjson",
    "compute engine",
    "scientific computing",
    "cas"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:epsil"
  ],
  "contributes": {
    "languages": [
      {
        "id": "epsil",
        "aliases": [
          "Epsil"
        ],
        "extensions": [
          ".epsil"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "epsil",
        "scopeName": "source.epsil",
        "path": "./syntaxes/epsil.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "epsil.runFile",
        "title": "Epsil: Run File",
        "icon": "$(play)"
      },
      {
        "command": "epsil.restartServer",
        "title": "Epsil: Restart Language Server"
      },
      {
        "command": "epsil.showInlineResults",
        "title": "Epsil: Show Inline Results",
        "icon": "$(eye)"
      },
      {
        "command": "epsil.clearInlineResults",
        "title": "Epsil: Clear Inline Results"
      },
      {
        "command": "epsil.showRepresentation",
        "title": "Epsil: Show Representation",
        "icon": "$(json)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "epsil.runFile",
          "when": "resourceLangId == epsil",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "epsil.showRepresentation",
          "when": "resourceLangId == epsil",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "epsil.runFile",
          "when": "resourceLangId == epsil"
        },
        {
          "command": "epsil.restartServer",
          "when": "resourceLangId == epsil"
        },
        {
          "command": "epsil.showInlineResults",
          "when": "resourceLangId == epsil"
        },
        {
          "command": "epsil.clearInlineResults",
          "when": "resourceLangId == epsil"
        },
        {
          "command": "epsil.showRepresentation",
          "when": "resourceLangId == epsil"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "epsil"
      }
    ],
    "debuggers": [
      {
        "type": "epsil",
        "label": "Epsil",
        "program": "./dist/debug-adapter.js",
        "runtime": "node",
        "languages": [
          "epsil"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path of the Epsil file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement.",
                "default": false
              },
              "statementTimeLimit": {
                "type": "number",
                "description": "Time limit per statement in milliseconds (0 = none). The only guard against a statement that never returns — pause acts between statements, not within one.",
                "default": 0
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "epsil",
            "request": "launch",
            "name": "Debug Epsil File",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Epsil: Debug File",
            "description": "Debug the Epsil file open in the active editor.",
            "body": {
              "type": "epsil",
              "request": "launch",
              "name": "Debug Epsil File",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Epsil",
      "properties": {
        "epsil.cliCommand": {
          "type": "string",
          "default": "",
          "description": "Command used by 'Epsil: Run File' to execute a source file in the terminal. Leave empty to run the Epsil CLI bundled with the extension (the same engine build used for diagnostics, inline results, and debugging). Set it to run a different engine, e.g. 'npx @cortex-js/epsil'."
        },
        "epsil.terminal.addToPath": {
          "type": "boolean",
          "default": true,
          "description": "Add an 'epsil' command to the PATH of integrated terminals, running the CLI bundled with the extension. Takes effect in newly created terminals."
        },
        "epsil.inlineResults.statementTimeLimit": {
          "type": "number",
          "default": 5000,
          "description": "Time limit per statement (in milliseconds) when computing inline results. 0 disables the limit."
        },
        "epsil.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report parse errors, lints, and static type errors as you type."
        },
        "epsil.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Epsil language server."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "pretest": "node build.mjs",
    "test": "node test/dap.test.mjs && node test/lsp.test.mjs",
    "package": "vsce package --out epsil.vsix",
    "publish:marketplace": "vsce publish --packagePath epsil.vsix",
    "vscode:prepublish": "node build.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
