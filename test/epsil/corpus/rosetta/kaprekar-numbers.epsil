// Kaprekar numbers up to 100: the digits of the square split into two parts
// that add up to the number itself. A one-digit square has no split. The
// range is short because a block inside a lambda inside `any` costs several
// milliseconds per number.
isKaprekar(n) = do {
  let ds = integerDigits(n^2)
  if length(ds) == 1 { n == 1 }
  else {
    any(1..(length(ds) - 1), i => do {
      let lo = fromDigits(drop(ds, i))
      lo > 0 && fromDigits(take(ds, i)) + lo == n
    })
  }
}
filter(1..100, isKaprekar)
// ➔ [1, 9, 45, 55, 99]
