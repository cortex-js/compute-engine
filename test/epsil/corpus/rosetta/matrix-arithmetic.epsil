// Matrix product, transpose, determinant, inverse and trace, all exact.
let a = [[1, 2], [3, 4]]
let b = [[5, 6], [7, 8]]
(matrixMultiply(a, b), transpose(a), det(a), inverse(a), trace(a), matrixMultiply(a, inverse(a)))
// ➔ ([[19, 22], [43, 50]], [[1, 3], [2, 4]], -2, [[-2, 1], [3/2, -1/2]], 5, [[1, 0], [0, 1]])
