// Bubble sort, rebuilding the list around each swap, checked against `sort`.
// The surrounding parts come from `take`/`drop`: a range `1..(j - 1)` cannot
// express an empty prefix because it is descending when j is 1.
bubbleSort(xs) = do {
  let ys = xs
  let n = length(ys)
  if n > 1 {
    for i in 1..(n - 1) {
      for j in 1..(n - i) {
        if ys[j] > ys[j + 1] {
          ys = [...take(ys, j - 1), ys[j + 1], ys[j], ...drop(ys, j + 1)]
        }
      }
    }
  }
  ys
}
let data = [5, 3, 8, 1, 9, 2, 7]
(bubbleSort(data), bubbleSort(data) == sort(data), bubbleSort([]), bubbleSort([1]))
// ➔ ([1, 2, 3, 5, 7, 8, 9], True, [], [1])
