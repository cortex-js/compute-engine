// Quicksort as a pure recursive function over filtered partitions, with the
// parameter typed and each partition materialized before the recursive call.
quicksort(xs: list<number>) =
  xs if length(xs) <= 1 else do {
    let pivot = first(xs)
    let others = rest(xs)
    [...quicksort(listFrom(filter(others, x => x < pivot))), pivot, ...quicksort(listFrom(filter(others, x => x >= pivot)))]
  }
quicksort([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5])
// ➔ [1, 1, 2, 3, 3, 4, 5, 5, 5, 6, 9]
