// Quicksort as a pure recursive function over filtered partitions. Each
// partition is a lazy `filter` whose lambda reads the block local `pivot`;
// passed to the recursive call, it keeps that binding.
quicksort(xs) =
  xs if length(xs) <= 1 else do {
    let pivot = first(xs)
    let others = rest(xs)
    [...quicksort(filter(others, x => x < pivot)), pivot, ...quicksort(filter(others, x => x >= pivot))]
  }
quicksort([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5])
// ➔ [1, 1, 2, 3, 3, 4, 5, 5, 5, 6, 9]
