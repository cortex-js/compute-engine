// corpus: known-failure a `length(xs)` call on an untyped parameter changes how a later lambda over `xs` is typed (ROADMAP: "A length call on an untyped parameter changes later static types")
// Quicksort as a pure recursive function over filtered partitions. With an
// untyped parameter, `length(xs)` changes how the comparison lambda is typed
// and the definition is refused before anything runs.
quicksort(xs) =
  xs if length(xs) <= 1 else do {
    let pivot = first(xs)
    let others = rest(xs)
    [...quicksort(filter(others, x => x < pivot)), pivot, ...quicksort(filter(others, x => x >= pivot))]
  }
quicksort([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5])
// ➔ [1, 1, 2, 3, 3, 4, 5, 5, 5, 6, 9]
