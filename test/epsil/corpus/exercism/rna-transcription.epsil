// DNA to RNA complement: G→C, C→G, T→A, A→U. A dictionary lookup with a
// computed key may be absent, so the mapped list is a `list<string | missing>`;
// `stringJoin` accepts it, and an absent element would be a run-time error.
let complement = {G -> "C", C -> "G", T -> "A", A -> "U"}
toRna(dna) = stringJoin(map(c => complement[c], characters(dna)), "")
toRna("ACGTGGTCTTAA")
// ➔ "UGCACCAGAAUU"
