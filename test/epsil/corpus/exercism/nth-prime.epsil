// The n-th prime, by trial division, compared with the library. For n = 2
// and n = 3 the range of the trial divisors is `2..1`, which has no element.
isPrimeByTrial(n) = n >= 2 && all(2..floor(sqrt(n)), d => n % d != 0)
nthPrimeByTrial(n) = do {
  let found = 0
  let k = 1
  while found < n {
    k = k + 1
    if isPrimeByTrial(k) { found = found + 1 }
  }
  k
}
(nthPrimeByTrial(1), nthPrimeByTrial(6), nthPrimeByTrial(100), nthPrime(100))
// ➔ (2, 13, 541, 541)
