// Integer to Roman numeral by greedy subtraction over a value table.
let table = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"),
  (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]
roman(n) = do {
  let out = ""
  let m = n
  for (value, letters) in table {
    while m >= value { out = "\(out)\(letters)"; m = m - value }
  }
  out
}
map(roman, [1, 4, 9, 14, 40, 90, 400, 1994, 2024, 3999])
// ➔ ["I", "IV", "IX", "XIV", "XL", "XC", "CD", "MCMXCIV", "MMXXIV", "MMMCMXCIX"]
