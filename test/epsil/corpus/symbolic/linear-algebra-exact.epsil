// Exact linear algebra: determinant, inverse, matrix rank, eigenvalues, a
// linear solve, and a symbolic determinant.
let m = [[2, 1], [1, 3]]
(det(m), inverse(m), matrixRank([[1, 2], [2, 4]]), eigenvalues([[2, 0], [0, 3]]), linearSolve(m, [3, 5]), det([[a, b], [c, d]]))
// ➔ (5, [[3/5, -1/5], [-1/5, 2/5]], 1, [2, 3], [4/5, 7/5], -b * c + a * d)
