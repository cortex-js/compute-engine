// Project Euler 21 (reduced): the sum of the amicable numbers below 1500,
// which are 220, 284, 1184 and 1210. The full problem (below 10000, answer
// 31626) runs correctly but takes about twenty seconds.
d(n) = sum(divisors(n)) - n
isAmicable(n) = do { let m = d(n); m != n && d(m) == n }
sum(filter(2..1499, isAmicable))
// ➔ 2898
