// Toggle a list of booleans by position, three doors and three passes: door
// k is toggled once per divisor of k, so only door 1 (the only perfect square
// up to 3) ends open. The tuple components of `zip(open, 1..3)` are typed from
// each source, so `!p[1]` is a boolean and `p[2] % pass` an integer.
let open = repeat(false, 3)
for pass in 1..3 {
  open = map(p => !p[1] if p[2] % pass == 0 else p[1], zip(open, 1..3))
}
open
// ➔ [True, False, False]
