// A `length(xs)` call on an untyped parameter narrows it to a collection, and
// the later uses of `xs` keep that type. (A repair meant for numeric guesses
// used to retype such a parameter as a matrix, and the comparison lambda was
// then refused.)
smaller(xs) = do {
  let n = length(xs)
  let p = first(xs)
  listFrom(filter(xs, x => x < p))
}
smaller([3, 1, 2])
// ➔ [1, 2]
