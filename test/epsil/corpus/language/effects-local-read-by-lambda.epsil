// The local `acc` is declared in the body, written only by the body's own
// loop, and merely READ by the lambda given to `filter`. The write cannot
// reach anything outside the call, so the function needs no `scope` effect.
f(n) = do {
  let acc = {}
  for p in 2..n { acc = union(acc, {p}) }
  filter(1..n, k => k !in acc)
}
f(5)
// ➔ [1]
