// A range written with `..` counts up: when its end is below its start, it
// has no element. So `1..(n - 1)` with n = 1 is empty, and `xs[1..(n - 1)]`
// reads nothing. To count down, write a negative step. The call `Range(a, b)`
// with no step counts toward `b` in either direction.
let n = 1
let xs = [10, 20, 30]
(listFrom(1..(n - 1)), xs[1..(n - 1)], listFrom(Range(3, 1, -1)), length(Range(5, 1)), listFrom(Range(10, 1, -3)), listFrom(Range(1, 0)))
// ➔ ([], [], [3, 2, 1], 5, [10, 7, 4, 1], [1, 0])
