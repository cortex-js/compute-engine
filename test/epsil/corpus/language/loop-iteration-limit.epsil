// corpus: known-failure a loop stops after 1024 turns by default (ROADMAP: "Default iteration limit of 1024 for Epsil programs")
// `ce.iterationLimit` defaults to 1024 and a `for` or `while` loop that
// runs longer is canceled with `iteration-limit-exceeded`. A program that
// counts to two thousand cannot run with the default.
let k = 0
for i in 1..2000 { k = k + 1 }
k
// ➔ 2000
