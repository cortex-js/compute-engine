// A list literal snapshots its elements, including a spread operand that is
// a finite lazy collection: the literal is a plain list, prints as one, and
// a loop that rebuilds a list from `take`/`drop` parts does not nest.
let ys = [1, 2, 3, 4]
let zs = [...take(ys, 1), 9, ...drop(ys, 2)]
(zs, zs == [1, 9, 3, 4])
// ➔ ([1, 9, 3, 4], True)
