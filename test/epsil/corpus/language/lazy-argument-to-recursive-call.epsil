// The `filter` is lazy and its lambda reads the block local `p`. Passed to
// the recursive call, it keeps the bindings of the block that made it, so it
// is evaluated with that `p` even after the block exited.
smallest(xs: list<number>) =
  xs if length(xs) <= 1 else do {
    let p = first(xs)
    smallest(filter(rest(xs), x => x < p))
  }
smallest([3, 1, 2])
// ➔ []
