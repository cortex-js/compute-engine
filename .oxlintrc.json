                  "!**/compilation/types.js"
                ],
                "message": "Type definition files must not import from implementation layers (boxed-expression/, symbolic/, library/, compilation/, tensor/, interval/); compilation/types is allowed."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/compute-engine/symbolic/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
