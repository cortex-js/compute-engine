                "group": [
                  "**/boxed-expression",
                  "**/boxed-expression/**",
                  "**/symbolic",
                  "**/symbolic/**",
                  "**/library",
                  "**/library/**",
                  "**/compilation",
                  "**/compilation/**",
                  "**/tensor",
                  "**/tensor/**",
                  "**/interval",
                  "**/interval/**",
