+// Probe only (not for delivery): with CE_EVENT_SITES=1, count each state
+// event by its kind and the first stack frame outside this file, and print
+// the counts when the process exits.
+const PROBE_EVENT_SITES =
+  (globalThis as { process?: { env?: Record<string, string | undefined> } })
+    .process?.env?.CE_EVENT_SITES === '1';
+const probeSites = new Map<string, number>();
+function probeRecordSite(label: string): void {
+  const frames = (new Error().stack ?? '').split('\n').slice(2);
+  const first = frames.findIndex(
+    (f) =>
+      !f.includes('engine-configuration-lifecycle') &&
+      !f.includes('_noteStateEvent')
+  );
+  const site = frames
+    .slice(first, first + 2)
+    .map((frame) =>
+      frame
+        .replace(/^\s*at\s+/, '')
+        .replace(/\(?\/.*\/src\//, '')
+        .replace(/:\d+\)?$/, '')
+    )
+    .join(' < ');
+  const key = `${label} | ${site}`;
+  probeSites.set(key, (probeSites.get(key) ?? 0) + 1);
+}
+if (PROBE_EVENT_SITES)
+  (
+    globalThis as unknown as {
+      process: { on: (e: string, f: () => void) => void };
+    }
+  ).process.on('exit', () => {
+    const rows = [...probeSites].sort((a, b) => b[1] - a[1]);
+    for (const [k, n] of rows) console.error(`${String(n).padStart(8)}  ${k}`);
+  });
+
