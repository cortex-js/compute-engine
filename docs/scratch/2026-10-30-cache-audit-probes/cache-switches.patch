diff --git a/src/compute-engine/boxed-expression/cache-switches.ts b/src/compute-engine/boxed-expression/cache-switches.ts
new file mode 100644
index 000000000..ca89e3531
--- /dev/null
+++ b/src/compute-engine/boxed-expression/cache-switches.ts
@@ -0,0 +1,20 @@
+/**
+ * Probe only (evaluation-cache audit, 2026-10-30): turn off named caches to
+ * measure what each one saves. `CE_CACHE_OFF=name1,name2` (or `all`).
+ * This module imports nothing, so that each module can import it with no
+ * dependency cycle.
+ */
+const off = new Set(
+  (
+    (globalThis as { process?: { env?: Record<string, string | undefined> } })
+      .process?.env?.CE_CACHE_OFF ?? ''
+  )
+    .split(',')
+    .map((s) => s.trim())
+    .filter(Boolean)
+);
+
+/** Is the cache `name` turned off for this probe run? */
+export function cacheOff(name: string): boolean {
+  return off.size > 0 && (off.has(name) || off.has('all'));
+}
