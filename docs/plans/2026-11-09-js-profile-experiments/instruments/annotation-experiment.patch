+++ b/test/compute-engine/compile-javascript-fragment-experiment.test.ts
@@ -0,0 +1,135 @@
+import { ComputeEngine, compile } from '../../src/compute-engine';
+import { ExperimentalScalarJavaScriptTarget } from '../../src/compute-engine/compilation/javascript-fragment-experiment';
+import { experimentalScalarFacts } from '../../src/compute-engine/compilation/javascript-fragment-experiment-facts';
+import { withRandomSeedFrame } from '../../src/compute-engine/boxed-expression/utils';
+import type { MathJsonExpression } from '../../src/math-json/types';
+
+function setup() {
+  const ce = new ComputeEngine();
+  ce.declare('x', 'real');
+  ce.declare('y', 'real');
+  ce.declare('C', 'boolean');
+  return { ce, target: new ExperimentalScalarJavaScriptTarget() };
+}
+
+const cases: Array<{
+  json: MathJsonExpression;
+  oracle: (x: number, y: number, c: boolean) => number | boolean;
+}> = [
+  {
+    json: [
+      'Add',
+      ['Sin', ['Multiply', 'x', 'y']],
+      ['Cos', ['Multiply', 'x', 'y']],
+    ],
+    oracle: (x, y) => Math.sin(x * y) + Math.cos(x * y),
+  },
+  {
+    json: ['Divide', ['Add', 'x', 2], ['Add', 'y', 1]],
+    oracle: (x, y) => (x + 2) / (y + 1),
+  },
+  {
+    json: ['If', 'C', ['Sqrt', 'x'], ['Negate', 'y']],
+    oracle: (x, y, c) => (c ? Math.sqrt(x) : -y),
+  },
+  { json: ['Add', ['Sqrt', 4], 'x'], oracle: (x) => 2 + x },
+  { json: ['Less', 'x', 'y'], oracle: (x, y) => x < y },
+];
+
+for (const cse of [false, true])
+  for (const constantFold of [false, true]) {
+    describe(`scalar annotation cse=${cse} fold=${constantFold}`, () => {
+      test.each(cases)(
+        'matches values and legacy emission for $json',
+        ({ json, oracle }) => {
+          const { ce, target } = setup();
+          const expr = ce.expr(json);
+          const options = { fallback: false, cse, constantFold };
+          const before = compile(expr, options);
+          const result = target.compile(expr, options);
+          const after = compile(expr, options);
+          expect(result.success).toBe(true);
+          expect(result.code).toBe(before.code);
+          expect(after.code).toBe(before.code);
+          const experiment = target.lastExperiment!;
+          expect(experiment.annotation.root).toBe(expr);
+          expect(experiment.checkedNodes).toBeGreaterThan(0);
+          expect(experiment.queries).toBeGreaterThanOrEqual(
+            experiment.checkedNodes
+          );
+          for (const [x, y] of [
+            [4, 2],
+            [-4, 3],
+            [0, -2],
+          ])
+            for (const C of [false, true]) {
+              const input = { x, y, C };
+              expect(result.run!(input)).toEqual(oracle(x, y, C));
+              expect(result.run!(input)).toEqual(before.run!(input));
+            }
+        }
+      );
+
+      test('keeps lazy random draw count and stream order', () => {
+        const { ce, target } = setup();
+        const expr = ce.expr([
+          'If',
+          'C',
+          ['Random'],
+          ['Add', ['Random'], ['Random']],
+        ]);
+        const options = { fallback: false, cse, constantFold };
+        const result = target.compile(expr, options);
+        const legacy = compile(expr, options);
+        for (const C of [false, true]) {
+          const sample = (run: () => unknown) =>
+            withRandomSeedFrame(ce, 42, () => [run(), ce._random()]);
+          expect(sample(() => result.run!({ C }))).toEqual(
+            sample(() => legacy.run!({ C }))
+          );
+          expect(sample(() => result.run!({ C }))).toEqual(
+            sample(() => expr.subs({ C }).N().re)
+          );
+        }
+      });
+    });
+  }
+
+test.each([
+  ['Sqrt', -1],
+  ['Complex', 1, 2],
+  ['List', 1, 2],
+  ['Power', 'x', 'y'],
+  ['If', 'C', 'x'],
+] as MathJsonExpression[])('declines outside scalar slice %j', (json) => {
+  const { ce, target } = setup();
+  expect(() => target.compile(ce.expr(json), { fallback: false })).toThrow(
+    /Scalar experiment/
+  );
+});
+
+test('declines stored bindings, unknown inputs, custom source, and complex mode', () => {
+  const { ce, target } = setup();
+  ce.assign('a', -2);
+  for (const json of ['a', 'u'] as MathJsonExpression[])
+    expect(() => target.compile(ce.expr(json), { fallback: false })).toThrow(
+      /Scalar experiment/
+    );
+  const expr = ce.expr(['Sin', 'x']);
+  expect(() => target.compile(expr, { mode: 'complex' })).toThrow(
+    /Scalar experiment/
+  );
+  expect(() =>
+    target.compile(expr, { functions: { Sin: 'Math.sin' } })
+  ).toThrow(/Scalar experiment/);
+});
+
+test('missing facts are an invariant error rather than a legacy recomputation', () => {
+  const { ce, target } = setup();
+  target.compile(ce.expr(['Sin', 'x']), { fallback: false });
+  const experiment = target.lastExperiment!;
+  const missing = ce.expr(['Cos', 'y']);
+  expect(() =>
+    experimentalScalarFacts(missing, { scalarExperiment: experiment } as never)
+  ).toThrow(/missing prepared-node facts/);
+});
