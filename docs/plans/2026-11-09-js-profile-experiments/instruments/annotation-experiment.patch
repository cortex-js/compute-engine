--- /dev/null
+++ b/src/compute-engine/compilation/javascript-fragment-experiment.ts
@@ -0,0 +1,149 @@
+/** Worktree-only integration of the real fragment pass and existing JS emitter. */
+import type { Expression } from '../global-types.js';
+import type { CompilationOptions, CompileTarget } from './types.js';
+import {
+  isFunction,
+  isNumber,
+  isSymbol,
+} from '../boxed-expression/type-guards.js';
+import { isSubtype } from '../../common/type/subtype.js';
+import { isLibraryOperator } from './builtin-callback.js';
+import { JavaScriptTarget } from './javascript-target.js';
+import {
+  typeFragment,
+  walkIf,
+  type FragmentDefinition,
+  type FragmentRule,
+  type FragmentValueType,
+} from './fragment.js';
+import type {
+  ScalarExperiment,
+  ScalarExperimentTarget,
+} from './javascript-fragment-experiment-facts.js';
+
+type Representation = 'number' | 'boolean';
+const realUnary: FragmentRule<Representation> = {
+  signatures: [{ operands: ['real'], result: 'real' }],
+};
+const numeric = (type: { kind: string }): Representation | undefined =>
+  type.kind === 'boolean'
+    ? 'boolean'
+    : type.kind === 'real' || type.kind === 'integer'
+      ? 'number'
+      : undefined;
+const definition: FragmentDefinition<Representation> = {
+  name: 'experimental strict JS scalar',
+  rules: {
+    Add: { signatures: [{ operands: ['real'], rest: 'real', result: 'real' }] },
+    Multiply: {
+      signatures: [{ operands: ['real'], rest: 'real', result: 'real' }],
+    },
+    Divide: { signatures: [{ operands: ['real', 'real'], result: 'real' }] },
+    Negate: realUnary,
+    Sin: realUnary,
+    Cos: realUnary,
+    Sqrt: realUnary,
+    Less: {
+      signatures: [
+        { operands: ['real', 'real'], rest: 'real', result: 'boolean' },
+      ],
+    },
+    Greater: {
+      signatures: [
+        { operands: ['real', 'real'], rest: 'real', result: 'boolean' },
+      ],
+    },
+    If: { walk: walkIf },
+    Random: { signatures: [{ operands: [], result: 'real' }] },
+  },
+  typeOfSymbol(node): FragmentValueType | undefined {
+    if (node.valueDefinition?.value !== undefined) return undefined;
+    const type = node.type.type;
+    if (isSubtype(type, 'boolean')) return { kind: 'boolean' };
+    if (isSubtype(type, 'integer')) return { kind: 'integer' };
+    if (isSubtype(type, 'real')) return { kind: 'real' };
+    return undefined;
+  },
+  representationOfBinding: numeric,
+  representationOfValue: numeric,
+  functionOf: () => undefined,
+};
+
+export class ExperimentalScalarJavaScriptTarget extends JavaScriptTarget {
+  lastExperiment?: ScalarExperiment;
+
+  protected prepareCompilation(
+    expr: Expression,
+    options: CompilationOptions<Expression>,
+    batch?: unknown
+  ): { expr: Expression; target: CompileTarget<Expression> } {
+    // Keep host source, batch/async variants, and alternative lanes outside
+    // this experiment. No public option or target registration is added.
+    if (
+      batch !== undefined ||
+      (options.mode !== undefined && options.mode !== 'strict') ||
+      options.functions ||
+      options.operators ||
+      options.vars ||
+      options.preamble ||
+      options.imports?.length ||
+      options.broadcast
+    )
+      throw new Error('Scalar experiment: unsupported compile options');
+    const prepared = super.prepareCompilation(expr, options);
+    const seen = new Set<Expression>();
+    const check = (node: Expression): void => {
+      if (seen.has(node)) return;
+      seen.add(node);
+      if (!node.isValid || node.type.type === 'error')
+        throw new Error('Scalar experiment: invalid or error-typed node');
+      if (isNumber(node) && node.im !== 0)
+        throw new Error('Scalar experiment: complex lane is outside the slice');
+      if (
+        isSymbol(node) &&
+        node.valueDefinition?.value !== undefined &&
+        node.symbol !== 'True' &&
+        node.symbol !== 'False'
+      )
+        throw new Error(
+          'Scalar experiment: stored bindings are outside the slice'
+        );
+      if (isFunction(node)) {
+        if (
+          !Object.hasOwn(definition.rules, node.operator) ||
+          !isLibraryOperator(node, node.operator)
+        )
+          throw new Error(
+            `Scalar experiment: unsupported head ${node.operator}`
+          );
+        // A strict unknown-sign radical stays real; a provably negative one
+        // promotes in the legacy emitter and must decline in this real slice.
+        if (node.operator === 'Sqrt' && node.op1.isNegative === true)
+          throw new Error(
+            'Scalar experiment: promoted radical is outside the slice'
+          );
+        if (node.operator === 'If' && node.nops !== 3)
+          throw new Error(
+            'Scalar experiment: only three-operand If is admitted'
+          );
+        for (const op of node.ops) check(op);
+      }
+    };
+    check(prepared.expr);
+    const annotation = typeFragment(prepared.expr, definition);
+    if (annotation.refusal)
+      throw new Error(`Scalar experiment: ${annotation.refusal.message}`);
+    for (const facts of annotation.scope.facts.values()) {
+      if (!('representation' in facts) || numeric(facts.type) === undefined)
+        throw new Error('Scalar experiment: non-scalar annotation');
+      if (facts.conversions?.some((conversion) => conversion.kind !== 'none'))
+        throw new Error(
+          'Scalar experiment: conversion outside real scalar slice'
+        );
+    }
+    const experiment = { annotation, queries: 0, checkedNodes: 0 };
+    this.lastExperiment = experiment;
+    (prepared.target as ScalarExperimentTarget).scalarExperiment = experiment;
+    return prepared;
+  }
+}
diff --git a/src/compute-engine/compilation/javascript-fragment-experiment-facts.ts b/src/compute-engine/compilation/javascript-fragment-experiment-facts.ts
new file mode 100644
--- /dev/null
+++ b/src/compute-engine/compilation/javascript-fragment-experiment-facts.ts
@@ -0,0 +1,50 @@
+/** Worktree experiment only: exact-node facts, with no analysis fallback. */
+import type { Expression } from '../global-types.js';
+import type { CompileTarget } from './types.js';
+import type { FragmentAnnotation, FragmentValueFacts } from './fragment.js';
+
+export type ScalarExperiment = {
+  annotation: FragmentAnnotation<'number' | 'boolean'>;
+  queries: number;
+  checkedNodes: number;
+};
+export type ScalarExperimentTarget = CompileTarget<Expression> & {
+  scalarExperiment?: ScalarExperiment;
+};
+
+export function experimentalScalarFacts(
+  node: Expression,
+  target: CompileTarget<Expression>
+): FragmentValueFacts<'number' | 'boolean'> | undefined {
+  const experiment = (target as ScalarExperimentTarget).scalarExperiment;
+  if (experiment === undefined) return undefined;
+  const facts = experiment.annotation.scope.facts.get(node);
+  if (facts === undefined || !('representation' in facts))
+    throw new Error(
+      `Scalar experiment: missing prepared-node facts for ${node}`
+    );
+  if (facts.representation !== 'number' && facts.representation !== 'boolean')
+    throw new Error(
+      `Scalar experiment: unsupported representation for ${node}`
+    );
+  experiment.queries++;
+  return facts;
+}
+
+export function experimentalOperandIsComplex(
+  node: Expression,
+  target: CompileTarget<Expression>
+): boolean | undefined {
+  const facts = experimentalScalarFacts(node, target);
+  return facts === undefined ? undefined : facts.type.kind === 'complex';
+}
+
+export function assertExperimentalPreparedNode(
+  node: Expression,
+  target: CompileTarget<Expression>
+): void {
+  const experiment = (target as ScalarExperimentTarget).scalarExperiment;
+  if (experiment === undefined) return;
+  experimentalScalarFacts(node, target);
+  experiment.checkedNodes++;
+}
