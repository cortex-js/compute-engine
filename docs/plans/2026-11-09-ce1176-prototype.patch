diff --git a/src/compute-engine/compilation/gpu-caller-binding.ts b/src/compute-engine/compilation/gpu-caller-binding.ts
new file mode 100644
index 000000000..25652f03d
--- /dev/null
+++ b/src/compute-engine/compilation/gpu-caller-binding.ts
@@ -0,0 +1,98 @@
+// PROTOTYPE (CE-1176 option (a), session compute-engine-a8). Not for delivery.
+//
+// Before a statement is compiled, bind each piece of caller code that the
+// statement evaluates unconditionally to a temporary of its shader type, in
+// the order of the interpreter. Lazy positions (the arms of a conditional,
+// the body of a loop) are not walked: they are bound when their own
+// statement (a branch, a loop body) is compiled.
+
+import type { Expression } from '../global-types.js';
+import { isFunction, isSymbol } from '../boxed-expression/type-guards.js';
+import type { CompileTarget } from './types.js';
+import { BaseCompiler } from './base-compiler.js';
+import { _codeAliases } from './compiler-mode.js';
+import { reachesCallerCodeOn } from './compile-folding.js';
+import { gpuTypeOfValue } from './gpu-declared-types.js';
+
+let counter = 0;
+
+/** Run `f` with the alias of `n` from an enclosing statement lifted. */
+function unaliased<T>(n: Expression, f: () => T): T {
+  const prev = _codeAliases.get(n);
+  if (prev === undefined) return f();
+  _codeAliases.delete(n);
+  try {
+    return f();
+  } finally {
+    _codeAliases.set(n, prev);
+  }
+}
+
+const LAZY_AFTER_FIRST = new Set(['If', 'Which', 'And', 'Or', 'Coalesce']);
+const BODY_HEADS = new Set(['Sum', 'Product', 'Loop', 'Function', 'Map']);
+
+export function gpuWithCallerCodeBound<T>(
+  unit: Expression,
+  target: CompileTarget<Expression>,
+  f: () => T
+): T {
+  const release = gpuBindCallerCode(unit, target);
+  try {
+    return f();
+  } finally {
+    release();
+  }
+}
+
+export function gpuBindCallerCode(
+  unit: Expression | undefined,
+  target: CompileTarget<Expression>
+): () => void {
+  // Each node bound here, with the alias an enclosing statement gave it.
+  const bound: [Expression, string | undefined][] = [];
+  const mine = new Set<Expression>();
+  const cleanup = () => {
+    for (const [n, prev] of bound.reverse())
+      if (prev === undefined) _codeAliases.delete(n);
+      else _codeAliases.set(n, prev);
+  };
+  if (unit === undefined || !BaseCompiler.canHoist(target)) return cleanup;
+  if (!reachesCallerCodeOn(unit, target)) return cleanup;
+  const bind = (n: Expression): void => {
+    const type = gpuTypeOfValue(n, target);
+    if (type === undefined) return; // prototype: leave it inline
+    const code = unaliased(n, () => BaseCompiler.compile(n, target));
+    const name = `_cc${++counter}`;
+    BaseCompiler.hoistStatement(target, `${type} ${name} = ${code};`);
+    bound.push([n, _codeAliases.get(n)]);
+    _codeAliases.set(n, name);
+    mine.add(n);
+  };
+  const visit = (n: Expression): void => {
+    if (mine.has(n)) return;
+    if (isSymbol(n)) {
+      if (unaliased(n, () => reachesCallerCodeOn(n, target))) bind(n);
+      return;
+    }
+    if (!isFunction(n)) return;
+    const h = n.operator;
+    if (h === 'Block') return; // its statements bind their own
+    if (LAZY_AFTER_FIRST.has(h)) {
+      if (n.ops[0] !== undefined) visit(n.ops[0]);
+      return;
+    }
+    if (BODY_HEADS.has(h) && n.nops > 1) {
+      // The bounds are evaluated once, before the loop.
+      for (const op of n.ops.slice(1)) visit(op);
+      return;
+    }
+    for (const op of n.ops) visit(op);
+    // The node's own evaluation runs caller code beyond its operands (a
+    // `functions` entry, a user function whose body has caller code).
+    const ops = new Set(n.ops);
+    if (unaliased(n, () => reachesCallerCodeOn(n, target, (m) => ops.has(m))))
+      bind(n);
+  };
+  visit(unit);
+  return cleanup;
+}
